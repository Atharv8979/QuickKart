SUPABASE_URL=https://nsmpjzetvyuwahoapksu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_FROM_SUPABASE_DASHBOARD
SUPABASE_ANON_KEY=sb_publishable_fgqz_cyI51R5KzVJk2uuDg_BXz0YCts

