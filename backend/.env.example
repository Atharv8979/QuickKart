# Server
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------
#  Gmail SMTP - sends the 6-digit password reset code
# ------------------------------------------------------------
# 1. Turn on 2-Step Verification for the Google account.
# 2. Google Account -> Security -> App passwords -> create one for "Mail".
# 3. Paste the 16-character app password below (NOT the normal password).
# If SMTP_USER / SMTP_PASS are empty, reset codes are printed to the server
# console instead of being emailed (development only, never in production).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.quickkart@gmail.com
SMTP_PASS=your_16_character_google_app_password
SMTP_FROM=your.quickkart@gmail.com
SMTP_FROM_NAME=QuickKart

# ------------------------------------------------------------
#  Password reset tuning (all optional - defaults shown)
# ------------------------------------------------------------
RESET_CODE_TTL_MINUTES=10
RESET_MAX_ATTEMPTS=5
RESET_RESEND_COOLDOWN_SECONDS=60
RESET_TOKEN_TTL_MINUTES=15

